{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/sector-reminders", "schedule": "0 14 * * *" }
  ],
  "rewrites": [
    { "source": "/assets/sector/brand-hero.webp", "destination": "/assets/sector/brand-hero.svg" },
    { "source": "/assets/sector/mascot-emotions.webp", "destination": "/assets/sector/mascot-emotions.svg" },
    { "source": "/assets/sector/rank-badges.webp", "destination": "/assets/sector/rank-badges.svg" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://t.me https://telegram.org https://web.telegram.org https://*.telegram.org" }
      ]
    }
  ]
}
